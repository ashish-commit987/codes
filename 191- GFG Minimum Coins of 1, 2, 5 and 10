class Solution {
    public int findMin(int n) {
        // code here
        int sum=0;
        int ten=n/10;
        n=n%10;
        int five=n/5;
        n=n%5;
        int second=n/2;
        n=n%2;
        int one=n/1;
        n=n%1;
        return sum=ten+five+second+one;
    }
}

